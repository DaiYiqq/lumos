# 统一使用 LF，避免 Windows/macOS 换行符差异污染 diff
* text=auto eol=lf

# 二进制资源必须是原样字节
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
*.zip binary
*.gz binary

# 生成物不参与 diff 统计
pnpm-lock.yaml linguist-generated=true
src-tauri/Cargo.lock linguist-generated=true
